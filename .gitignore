dist/

# 예전 Express 백엔드가 로컬에 만들던 파일들. 백엔드는 Cloudflare Worker 전용으로
# 바뀌었지만(2026-07), 이미 로컬에 남아 있는 파일이 git에 잡히지 않도록 유지한다.
web/sessions/
web/public/shares/

# Claude Code 로컬 설정 (개인/머신 전용)
.claude/

# 원본(대용량) 배너 소스 이미지 — 최적화본 web/public/hero.jpg 만 커밋
Gemini_Generated_Image_*.png

# wrangler / worker
.wrangler/
.dev.vars
node_modules/

# 예전 Express 백엔드가 만들던 런타임 설정 파일 (지금은 KV에 저장)
web/settings.json

# 로컬 환경변수 (시크릿 포함) — 절대 커밋 금지. 예시는 .dev.vars.example 참고
# (wrangler는 .dev.vars 를 읽는다. 위쪽에서 이미 무시 처리됨)
.env
*.env
!.env.example
!*.env.example
